{
  "$schema": "https://bridge.playgama.com/v2/stable/schema.json",
  "debug": false,
  "advertisement": {
    "minimumDelayBetweenInterstitial": 60,
    "interstitial": {
      "disable": false,
      "preloadOnStart": "level_completed",
      "placementFallback": "level_completed",
      "placements": [
        {
          "id": "level_completed"
        },
        {
          "id": "level_failed"
        },
        {
          "id": "pause_restart"
        },
        {
          "id": "pause_menu"
        }
      ]
    },
    "rewarded": {
      "disable": false,
      "preloadOnStart": "bonus_coins",
      "placementFallback": "bonus_coins",
      "placements": [
        {
          "id": "bonus_coins"
        }
      ]
    },
    "useBuiltInErrorPopup": false
  },
  "sendAnalyticsEvents": false,
  "disableLoadingLogo": true
}
