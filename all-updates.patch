+.vthumb.noimg { background: rgba(255,255,255,0.05); }
+.vinfo { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 10px; padding: 2px 6px 4px; }
+.vname { flex: 1 1 100%; font-size: 22px; letter-spacing: 0.04em; }
+.tier { display: inline-flex; gap: 3px; }
