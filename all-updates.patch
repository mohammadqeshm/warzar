+.tg.price { background: var(--y); color: #0E0E0E; font-size: 18px; }
+.shop-detail { width: min(34vw, 380px); align-self: flex-end; padding: 16px 18px; display: flex; flex-direction: column; gap: 10px; max-height: 100%; overflow-y: auto; }
+.dname { font-size: 34px; letter-spacing: 0.05em; color: var(--y); line-height: 1; }
