+.shop-main { flex: 1; min-height: 0; display: flex; justify-content: space-between; gap: 14px; }
+.shop-list { width: min(34vw, 360px); overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding: 4px 6px 8px 2px; scrollbar-width: thin; }
+.vcard { position: relative; flex: 0 0 auto; display: flex; flex-direction: column; padding: 6px; font: inherit; text-align: left; color: var(--w); background: linear-gradient(160deg, rgba(40,44,50,0.92), rgba(16,18,22,0.92)); border: 3px solid #0E0E0E; border-radius: 8px; box-shadow: 0 0 0 2px rgba(236,233,225,0.25); cursor: pointer; transition: transform 0.1s; }
+.vcard:hover { transform: translateX(3px); }
